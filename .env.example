# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_URI=

# ── Auth (NextAuth) ────────────────────────────────────────────────────────────
# NEXTAUTH_URL must be the exact production URL (no trailing slash)
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=

# ── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# ── Supabase (file uploads) ───────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── LinkedIn Email Scraper Extension ──────────────────────────────────────────
# Must match the API_KEY constant at the top of chrome-extension/background.js
SCRAPER_API_KEY=

# ── Vercel Cron protection ────────────────────────────────────────────────────
CRON_SECRET=

# ── AI Email Importer — provider selector ─────────────────────────────────────
# Which provider /api/admin/ai-import calls — "openrouter" (default) | "gemini".
# Switching providers is just this env var; no code change needed.
AI_PROVIDER=openrouter

# ── AI Email Importer (OpenRouter) ──────────────────────────────────────────────
# Get your free key at: https://openrouter.ai → API Keys
OPENROUTER_API_KEY=
# Optional: comma-separated fallback chain of free-tier model IDs, in priority
# order. Every entry MUST end in ":free" — non-free entries are dropped, never
# substituted. Falls back to a built-in default chain if unset. Before adding a
# model, verify it's actually free right now (IDs get reclassified without
# notice): curl https://openrouter.ai/api/v1/models -H "Authorization: Bearer $OPENROUTER_API_KEY"
OPENROUTER_MODELS=

# ── AI Email Importer (Gemini — alternate/fallback provider) ──────────────────
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: comma-separated fallback chain of model IDs, in priority order.
# IMPORTANT: a model being listed by the Gemini API does NOT mean it's usable
# on your key — free-tier eligibility varies by model and account, and IDs
# like "gemini-2.5-flash" can 404 as "no longer available to new users" while
# still appearing in the model list. Verify any replacement with a real
# generateContent() call before trusting it, not just the /models listing.
GEMINI_MODELS=
